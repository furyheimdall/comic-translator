# 환경 변수 참고용 예시입니다. 실제 비밀번호·토큰을 이 파일에 넣지 마세요.
# 권장: python3 scripts/install.py 로 저장소 밖의 전용 설정 파일을 생성하세요.
# 앱은 .env 파일을 자동으로 읽지 않습니다. 설치기가 만든 실행기/systemd를 사용하세요.
CT_HOST=127.0.0.1
CT_PORT=8710
CT_DATA_DIR="/absolute/path/to/comic-translator-data"
CT_KOHARU_FONT="Noto Sans CJK KR"

# 외부 주소(0.0.0.0 등)에 바인딩할 때는 반드시 로그인 비밀번호를 설정하세요.
# 설치기의 --password-file 또는 숨김 입력을 사용하면 명령 이력에 남지 않습니다.
# CT_PASSWORD="사용자별로 설정할 비밀번호"

# 모델 캐시 위치와 Hugging Face 토큰은 앱의 '모델 준비' 화면에서 저장합니다.

# 이미 설치한 엔진/폰트를 사용할 때의 경로 재정의
# CT_KOHARU_BIN="/absolute/path/to/ct_batch"
# CT_MT_DIR="/absolute/path/to/MangaTranslator"
# CT_MT_PYTHON="/absolute/path/to/MangaTranslator/.venv/bin/python"
# CT_FONT_DIR="/absolute/path/to/fonts/korean"
