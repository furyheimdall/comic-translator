+fn text_detection(mask: &GrayImage, bounds: [i32; 4]) -> Option<KoharuLayoutDetection> {
+    let [left, top, right, bottom] = mask_window(
+        bounds.map(|value| value as f32),
+        mask.width(),
+        mask.height(),
+    )?;
+    let mut pixels = Vec::with_capacity((right - left) as usize * (bottom - top) as usize);
+    let mut area = 0;
+    for y in top..bottom {
+        let row = y as usize * mask.width() as usize;
+        for &pixel in &mask.as_raw()[row + left as usize..row + right as usize] {
+            area += u32::from(pixel != 0);
+            pixels.push(pixel);
+        }
+    }
+    (area > 0).then_some(KoharuLayoutDetection {
+        label_id: 0,
+        label: "text".to_owned(),
+        score: 0.0, // ComicTextDetector produces no confidence score.
+        bbox: bounds.map(|value| value as f32),
+        area,
+        mask: KoharuLayoutMask {
+            x: left,
+            y: top,
+            width: right - left,
+            height: bottom - top,
+            pixels,
+        },
+    })
+}
