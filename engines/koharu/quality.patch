+fn split_text_block(block: TextBlock) -> Vec<[i32; 4]> {
+    let mut lines = block.lines;
+    if block.vertical {
+        lines.sort_unstable_by_key(|quad| Reverse(quad.iter().map(|point| point[0]).min().unwrap()));
+    } else {
+        lines.sort_unstable_by_key(|quad| quad.iter().map(|point| point[1]).min().unwrap());
+    }
+    let mut groups = Vec::new();
+    let mut current: Option<[i32; 4]> = None;
+    for quad in lines {
+        let bounds = quad_bounds(&quad);
+        if let Some(previous) = current {
+            let gap = if block.vertical {
+                previous[0] - bounds[2]
+            } else {
+                bounds[1] - previous[3]
+            };
+            if gap as f32 > block.detected_font_size / 2.0 {
+                groups.push(previous);
+                current = None;
+            }
+        }
+        current = Some(if let Some(previous) = current {
+            [
+                previous[0].min(bounds[0]),
+                previous[1].min(bounds[1]),
+                previous[2].max(bounds[2]),
+                previous[3].max(bounds[3]),
+            ]
+        } else {
+            bounds
+        });
+    }
+    if let Some(last) = current {
+        groups.push(last);
+    }
+    groups
+}
+
+fn quad_bounds(quad: &Quad) -> [i32; 4] {
+    let mut bounds = [i32::MAX, i32::MAX, i32::MIN, i32::MIN];
+    for &[x, y] in quad {
+        bounds[0] = bounds[0].min(x);
+        bounds[1] = bounds[1].min(y);
+        bounds[2] = bounds[2].max(x);
+        bounds[3] = bounds[3].max(y);
+    }
+    bounds
+}
